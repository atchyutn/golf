<div class="mb-4">
  <%= f.label :first_name, class: 'form-label fw-semibold' %><br />
  <%= f.text_field :first_name, class: 'form-control', autofocus: true %>
</div>

<div class="field">
  <%= f.hidden_field :email, value: email %>
  <%= f.hidden_field :provider, value: @provider %>
  <% if @invite_id.present? %>
    <%= f.hidden_field :invite_id, value: @invite_id %>
  <% end %>
</div>

<div class="mb-4">
  <%= f.label :last_name, class: 'form-label fw-semibold' %><br />
  <%= f.text_field :last_name, class: 'form-control', autofocus: true, autocomplete: "last_name" %>
</div>

<div class="mb-4">
  <%= f.label :handicap, class: 'form-label fw-semibold' %><br />
  <%= f.text_field :handicap, class: 'form-control', autofocus: true %>
</div>

<div class="mb-4">
  <%= f.label :phone_number, class: 'form-label fw-semibold' %><br />
  <%= f.text_field :phone_number, class: 'form-control', autofocus: true %>
</div>

<div class="mb-4">
  <%= f.label :email, class: 'form-label fw-semibold' %><br />
  <%= f.text_field :email, class: 'form-control', autofocus: true, value: email %>
</div>
