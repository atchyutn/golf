Hi <%= @invitation.invitee_email %>


<%= @invitation.requester.full_name %> invited you to the team as a <%= @invitation.player_type %>


<% if User.find_by(email: @invitation[:invitee_email]).present? %>
   <%#= link_to "Accept Invite", new_user_session_url(invitation_id: @invitation.id) %>
