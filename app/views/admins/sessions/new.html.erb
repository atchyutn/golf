<div class="devise-form-container">
  <h2 class="devise-form-header">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {class: "devise-form"}) do |f| %>
    <div class="field">
      <%= f.label :email, class: "devise-form-label" %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "devise-form-input" %>
    </div>

    <div class="field">
      <%= f.label :password, class: "devise-form-label" %><br />
      <%= f.password_field :password, autocomplete: "current-password", class: "devise-form-input" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <%= f.check_box :remember_me, class: "devise-form-checkbox" %>
        <%= f.label :remember_me, class: "devise-form-checkbox-label" %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "Log in", class: "devise-form-button" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
