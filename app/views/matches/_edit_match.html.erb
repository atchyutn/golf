<div
	class="modal fade"
	id="matchInfo"
	tabindex="-1"
	aria-labelledby="matchInfoLabel"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered">
	<div class="modal-content">
		<div class="modal-header">
		<h5 class="modal-title" id="matchInfoLabel">Match information</h5>
		<button
			type="button"
			class="btn-close"
			data-bs-dismiss="modal"
			aria-label="Close"
		></button>
		</div>
		<%= form_with model: @match, url: match_path, method: :put, remote: true do |f| %>
			<div class="modal-body">
				<!-- Home course select -->
				<div class="mb-4">
					<label for="date" class="form-label fw-semibold">Date</label>
					<input
					type="text"
					name="match[match_time]"
					id="datetimepicker"
					class="form-control calendar"
					id="date"
					placeholder="Date and Time"
					value=<%= @match.match_time ? @match.match_time.strftime('%Y/%m/%d %H:%M') : 'Select a date' %>
					/>
				</div>
				<div class="mb-4">
					<label for="course" class="form-label fw-semibold">Course</label>
					<select class="form-select" name="match[home_course_id]" id="user_home_course">
						<% unless @match.home_course.present? %>
							<option value="" selected disabled>Select home course</option>
						<% end %>
						<% HomeCourse.pluck(:name, :id).each do |name, id| %>
							<option value="<%= id %>" <%= 'selected' if @match.home_course.present? && @match&.home_course&.id == id %>><%= name %></option>
						<% end %>
					</select>
				</div>
				</div>
				<div class="modal-footer">
					<%= f.submit 'Save', class: 'btn greenBtn', id: 'save-button' %>
				</div>
			</div>
		<% end %>
	</div>
</div>
