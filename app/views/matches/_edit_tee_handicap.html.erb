<script>
  function toggleHandicapInput(button) {
    const playerSelection = button.closest('.player-tee-selection');
    const handicapInput = playerSelection.querySelector('.handicap-input');
    const handicapDisplay = playerSelection.querySelector('.handicap-display');
    const saveButton = playerSelection.querySelector('save');

    if (handicapInput.style.display === 'none') {
      handicapInput.style.display = 'inline';
      handicapDisplay.style.display = 'none';
      handicapInput.focus();
      saveButton.disabled = false;
  
    } else {
      handicapInput.style.display = 'none';
      handicapDisplay.style.display = 'inline';
    }
  }

  // Add event listener for Enter key to save the handicap
  document.querySelectorAll('.handicap-input').forEach(input => {
    input.addEventListener('keypress', function(event) {
      if (event.key === 'Enter') {
        event.preventDefault(); // Prevent form submission
        const playerSelection = this.closest('.player-tee-selection');
        const handicapDisplay = playerSelection.querySelector('.handicap-display');
        const saveButton = document.getElementsByClassName('save')[0];
        handicapDisplay.textContent = `Hcp: ${this.value}`;
        saveButton.disabled = false;

        
        // Hide the input field
        this.style.display = 'none';
        handicapDisplay.style.display = 'inline';
      }
    });
  });
</script>