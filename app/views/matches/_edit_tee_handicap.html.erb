 <div class="card select-tees-container">
		<div class="cardHeader profileHeader">
			<div class="left">
				<h3>Select Handicap & Tee</h3>
			</div>
		</div>
		<div class="profileWrap">
  
<%= form_with model: @match, url: match_path(@match), method: :put, id: 'match_form', remote: true do |f| %>
  <%= f.hidden_field :id %>
  <%= f.hidden_field :match_time %>

  <% @match.teams.each do |team| %>
    <h5 class="mb-3"><%= team.name %></h5>
    <% team.players.where(player_type: ['player', 'captain']).each do |player| %>
      <div class="player-tee-selection">
        <div class="player-info col-4">
          <p class="name"><%= player.full_name %></p>
          <div class="player-details">
            <span class="handicap">
              <%= text_field_tag "player_handicaps[#{player.id}]", player.handicap, class: 'form-control handicap-input', placeholder: 'Enter handicap', style: 'display: none;' %>
              <span class="handicap-display" style="display: inline;">Hcp: <%= player.handicap %></span>
            </span>
            <button class="edit-icon" onclick="toggleHandicapInput(this)">
              <i class="bx bx-pencil"></i>
            </button>
          </div>
        </div>
        <%= select_tag "player_tees[#{player.id}]",
          options_for_select(@match.home_course.tees.where("COALESCE(slope_rating, '') != ?", 'N/D').pluck(:name), player.users_tees.find_by(match_id: @match.id)&.tee&.name),
          { class: 'form-select' }
        %>
      </div>
    <% end %>
  <% end %>

  <div class="buttonsWrap d-flex justify-content-end">
    <%= f.submit 'Save', class: "btn greenBtn save", id: 'match_handicap_form' %>
  </div>
<% end %>


</div>

	<%# Match Information %>
 <%
=begin%>
 <div class="card">
		<div class="cardHeader profileHeader">
			<div class="left">
				<div class="info">
				<div class="name">Match information</div>
				<% if current_user.home_team_captain? %>
					<div class="sub">
						Please confirm the course with the other team before editing.
					</div>
				<% end %>
				</div>
			</div>
			<% if current_user.home_team_captain? %>
				<div class="right">
				<a
					href="#"
					class="btn whiteBtn iconBtn btnSmall edit-match"
					data-bs-toggle="modal"
					data-bs-target="#matchInfo"
				>
					<i class="bx bx-pencil"></i>
					Edit</a
				>
				</div>
			<% end %>
		</div>
		<%= render partial: 'matches/match_information', locals: { key: @match.status, key_match: @match, display_text: true } %>
	</div>  
<%
=end%>





