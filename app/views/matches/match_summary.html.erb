<div class="matchesWrap">
  <div class="container maxWidth888">
  	<%= render partial: 'layouts/tabs', locals: { match_started: true, page: ''} %>
    <div class="sectionTitle">Score Summary</div>
  	<div class="teams-container">
  <% const = 1 %>
  <% max_val = @match.teams.maximum(:final_standing) %>
  <% @match.teams.order(id: :asc).each.with_index do |team, index| %>
    <div class="team-row">
      <div class="team-info">
        <div class="avatar-container">
          <% captains = team.players.select { |player| player.captain? } %>
          <% regular_players = team.players.select { |player| player.player? } %>
          <% (captains + regular_players).each do |player| %>
            <% unless player.reserved_player? %>
              <div class="player-avatars">
                <% if player.image.attached? %>
                  <%= image_tag player.image, class: "team-avatar" %>
                <% else %>
                  <%= image_tag 'profile-pic-1.jpeg', alt: player.full_name, class: "team-avatar" %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="player-details">
          <% (captains + regular_players).each do |player| %>
            <% unless player.reserved_player? %>
              <p><%= player.full_name %>, <%= player.handicap %> hcp</p>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="team-label <%= const == 1 ? 'text-success' : 'text-primary' %>">Team <%= const %></div>
      <div class="team-status up"><span> <%= current_hole_standing(@match, team, (index == 0 ? 'team1' : 'team2')) %></span></div>
    </div>
    <% const += 1 %>
  <% end %>
</div>
  </div>

	<div class="container maxWidth888 score-card">
  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <button class="tab-btn active" data-tab="front">Front 9</button>
    <button class="tab-btn" data-tab="back">Back 9</button>
  </div>

  <!-- Front 9 Section -->
  <div id="scorecard-front">
    <div class="tableWrap noPadding">
      <table class="table bordered">
        <thead>
          <tr>
            <th>Hole</th>
            <%= generate_hole_columns(@match.home_course, 1, 9) %>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>Par (M | F)</th>
            <%= generate_cells(@match, 'Par', 1, 9) %>
          </tr>
          <tr>
            <th>SI (M | F)</th>
            <%= generate_cells(@match, 'Handicap', 1, 9) %>
          </tr>
          <% const = 1 %>
          <% @match.teams.order(id: :asc).each do |team| %>
            <tr>
              <th style="color: <%= const == 1 ? 'blue' : 'red' %>;">Team <%= const %></th>
              <td colspan="9"></td>
            </tr>
            <% captains = team.players.select { |player| player.captain? } %>
            <% regular_players = team.players.select { |player| player.player? } %>
            <% reserved_players = team.players.select { |player| player.reserved_player? } %>
            <% (captains + regular_players).each do |player| %>
              <tr>
                <th style="color: <%= const == 1 ? 'blue' : 'red' %>;"><%= "#{player.full_name} - fhcp: (#{@match.course_handicaps.find_by(user_id: player.id)&.final_handicap.to_i})" %></th>
                <%= generate_shot_cells(player, @match, 1, 9) %>
              </tr>
              <tr>
                <th style="color: <%= const == 1 ? 'blue' : 'red' %>;">Scores</th>
                <%= generate_score_cells(player, @match, 1, 9) %>
              </tr>
            <% end %>
            <% const += 1 %>
          <% end %>
          <tr>
            <th>Standings</th>
            <%= current_standing(@match, 1, 9) %>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Back 9 Section -->
  <div id="scorecard-back" style="display: none;">
    <div class="tableWrap noPadding">
      <table class="table bordered">
        <thead>
          <tr>
            <th>Hole</th>
            <%= generate_hole_columns(@match.home_course, 10, 18) %>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>Par (M | F)</th>
            <%= generate_cells(@match, 'Par', 10, 18) %>
          </tr>
          <tr>
            <th>SI (M | F)</th>
            <%= generate_cells(@match, 'Handicap', 10, 18) %>
          </tr>
          <% const = 1 %>
          <% @match.teams.order(id: :asc).each do |team| %>
            <tr>
              <th style="color: <%= const == 1 ? 'blue' : 'red' %>;">Team <%= const %></th>
              <td colspan="9"></td>
            </tr>
            <% captains = team.players.select { |player| player.captain? } %>
            <% regular_players = team.players.select { |player| player.player? } %>
            <% reserved_players = team.players.select { |player| player.reserved_player? } %>
            <% (captains + regular_players).each do |player| %>
              <tr>
                <th style="color: <%= const == 1 ? 'blue' : 'red' %>;"><%= "#{player.full_name} - fhcp: (#{@match.course_handicaps.find_by(user_id: player.id)&.final_handicap.to_i})" %></th>
                <%= generate_shot_cells(player, @match, 10, 18) %>
              </tr>
              <tr>
                <th style="color: <%= const == 1 ? 'blue' : 'red' %>;"><%= "Scores" %></th>
                <%= generate_score_cells(player, @match, 10, 18) %>
              </tr>
            <% end %>
            <% const += 1 %>
          <% end %>
          <tr>
            <th>Standings</th>
            <%= current_standing(@match, 10, 18) %>
          </tr>
        </tbody>
      </table>
      <% if @winner %>
        <p class="early-win"><%= @winner %></p>
      <% end %>
    </div>
  </div>
</div>

		<div class="container buttonsWrap justify-content-center maxWidth888">
			<% if current_user.captain? && current_user.team.home %>
				<%= link_to "Edit", edit_scores_path(id: @match.id), class: "btn whiteBtn", onclick: "window.location.href = this.href; return false;" %>
				<!-- Simple direct approach -->
      <button type="button" class="btn greenBtn" id="show-modal-btn">Submit scores</button>

      <!-- Hidden form for actual submission -->
      <form action="/matches/<%= @match.id %>/final_scores" method="post" id="final-scores-form" style="display: none;">
        <input type="hidden" name="_method" value="put">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="submit" id="actual-submit">
      </form>
			<% else %>
				<%= form_with model: @match, url: confirm_score_path, method: :put do |f| %>
					<%= hidden_field_tag :id, @match.id %>
					<%= hidden_field_tag :confirmed, true %>
					<div>
						<%= f.submit "Confirm score", class: "btn greenBtn" %>
					</div>
				<% end %>
			<% end %>
  	</div>
  </div>
<!-- Modal Structure -->
<div class="modal fade score-card-modal" id="scoreConfirmationModal" tabindex="-1" aria-labelledby="scoreConfirmationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="matchInfoModalLabel">
          <!-- Will be filled dynamically -->
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="avatar-container justify-content-center mb-3">
          <%# Will be filled dynamically %>
        </div>
        <div class="d-flex justify-content-center mb-3">
          <div class="team-status up">
            <!-- Will be filled dynamically -->
          </div>
        </div>
        <div class="modal-desc mb-4">
          <p>
            <!-- Will be filled dynamically -->
          </p>
          <p>Please review and submit your scorecard.</p>
          <p>
            The opposing team captain will be asked to verify the scorecard.
          </p>
          <p>
            Once verified, the scorecard will be registered and the match
            will conclude.
          </p>
        </div>
        <div class="d-flex justify-content-center">
          <% begin %>
          <button id="submit-final-scores" class="btn btn-primary">Review and submit</button> 
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- jQuery and Bootstrap JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
