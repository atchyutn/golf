  padding: 10px 20px;
  border: 1px solid #d0d5dd;
  background-color: #ffffff;
  color: #000000;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  border-radius: 10px;
  margin: 0 5px;
  transition: background-color 0.3s, color 0.3s;
}

.tab-btn.active {
  background-color: #000000;
  color: #ffffff;
  border-color: #000000;
}

/* Hide Back 9 Section by Default */
#scorecard-back {
  display: none;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const tabButtons = document.querySelectorAll(".tab-btn");
  const frontSection = document.getElementById("scorecard-front");
  const backSection = document.getElementById("scorecard-back");

  tabButtons.forEach((button) => {
    button.addEventListener("click", () => {
      // Remove active class from all buttons
      tabButtons.forEach((btn) => btn.classList.remove("active"));

      // Add active class to the clicked button
      button.classList.add("active");

      // Show/hide sections based on the selected tab
      const tab = button.getAttribute("data-tab");
      if (tab === "front") {
        frontSection.style.display = "block";
        backSection.style.display = "none";
      } else if (tab === "back") {
        frontSection.style.display = "none";
        backSection.style.display = "block";
      }
    });
  });
});  


// Add a simple debug function to log what's happening
function logToConsole(message) {
  console.log(`[DEBUG] ${new Date().toISOString()}: ${message}`);
}

document.addEventListener("DOMContentLoaded", function() {
  // Log for debugging
  console.log('DOM content loaded, setting up handlers');
  
  // Get the button and form elements
  const showModalBtn = document.getElementById('show-modal-btn');
  const form = document.getElementById('final-scores-form');
  
  if (showModalBtn && form) {
    console.log('Found show-modal-btn and final-scores-form');
    
    // Add click handler to the show modal button
    showModalBtn.addEventListener('click', function(e) {
      e.preventDefault();
      console.log('Show modal button clicked');
      
      // Instead of just showing the modal, let's make the AJAX request directly
      // This ensures we get the data before showing the modal
      const matchId = form.action.split('/')[4].split('.')[0]; // Extract match ID from form action
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      
      console.log(`Making AJAX request to get winner data for match ID: ${matchId}`);
      
      // Use fetch API for the request
      fetch(`/matches/${matchId}/final_scores`, {
        method: 'PUT',
        headers: {
          'X-CSRF-Token': csrfToken,
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        }
      })
      .then(response => {
        console.log(`Response status: ${response.status}`);
        if (!response.ok) {
          throw new Error(`HTTP error! Status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('Data received from controller:', data);
        
        // Update modal with winner data
        updateModalWithData(data);
        
        // Now show the modal with the updated data
        const modal = new bootstrap.Modal(document.getElementById('scoreConfirmationModal'));
        modal.show();
        console.log('Modal shown with winner data');
      })
      .catch(error => {
        console.error('Error fetching data:', error);
        // Show modal anyway, but without data
        const modal = new bootstrap.Modal(document.getElementById('scoreConfirmationModal'));
        modal.show();
      });
    });
  }
  
  function updateModalWithData(data) {
    console.log('Updating modal with data:', data);
    
    // Update modal title
    document.querySelector('#scoreConfirmationModal .modal-title').textContent = "We have a winner!";
    
    // Clear and update avatar container
    const avatarContainer = document.querySelector('#scoreConfirmationModal .avatar-container');
    if (avatarContainer && data.winner && data.winner.players) {
      avatarContainer.innerHTML = '';
      
      data.winner.players.forEach(player => {
        const avatarHTML = `
          <div class="player-avatars">
            <img src="${player.image_url || '/assets/profile-pic-1.jpesg'}" class="avatar" />
          </div>
        `;
        avatarContainer.insertAdjacentHTML('beforeend', avatarHTML);
      });
    }
    
    // Update team status with scores
    const teamStatusDiv = document.querySelector('#scoreConfirmationModal .team-status');
    if (teamStatusDiv) {
      teamStatusDiv.innerHTML = `
        ${data.standing}&${data.remaining_holes} <span>Winner</span>
      `;
    }
    
    // Update description
    const modalDesc = document.querySelector('#scoreConfirmationModal .modal-desc');
    if (modalDesc && data.winner && data.winner.players && data.winner.players.length >= 2) {
      modalDesc.innerHTML = `
        <p><b>${data.winner.players[0].full_name}</b> and <b>${data.winner.players[1].full_name}</b> win the match.</p>
        <p>Please review and submit your scorecard.</p>
        <p>The opposing team captain will be asked to verify the scorecard.</p>
        <p>Once verified, the scorecard will be registered and the match will conclude.</p>
      `;
    }
  }
  
  // Add direct event listener for the submit button in the modal
  const submitFinalScoresBtn = document.getElementById('submit-final-scores');
  if (submitFinalScoresBtn && form) {
    console.log('Found submit-final-scores button');
    
    submitFinalScoresBtn.addEventListener('click', function() {
      console.log('Submit final scores button clicked - redirecting to match summary');
      // Instead of submitting the form, redirect to the match summary page
      window.location.href = `/matches/${form.action.split('/')[4].split('.')[0]}/match_summary`;
    });
  }
});

// The controller response will handle updating the modal with data
</script>
