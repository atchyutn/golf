<script>
document.addEventListener("DOMContentLoaded", function () {
  // Enhanced score submission handler
  document.querySelector('.submit-scores')?.addEventListener('click', function(e) {
    e.preventDefault();
    // Show the modal
    const modal = new bootstrap.Modal(document.getElementById('scoreConfirmationModal'));
    modal.show();
  });

  // Keep existing form submission handler
  document.getElementById('confirm-submission')?.addEventListener('click', function() {
    document.getElementById('score-submission-form').submit();
  });
});
</script>
