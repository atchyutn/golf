<div class="signUpWrap">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-5">
        <div class="card borderCard text-center">
          <div class="card-body">
            <h2 class="card-title fw-bold mb-2">Magic link sent!</h2>
            <p class="card-text mb-4">
              We just sent an email to you at<br />
              <%= @email %><br />
              It contains a link that’ll sign you in super quick. If you do not see the invite link in your inbox, please check your spam folder
            </p>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
