<% if user_signed_in? %>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <%= image_tag 'FBround.png', alt: '', height: '86', class: 'roundedLogo' %>
        <%= image_tag 'MatchPlay2025.png', alt: '', height: '28', class: 'matchText' %>
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <%= image_tag 'Hamburger.png', alt: '', height: '28', class: 'Hamburger' %>
      </button>
      <div class="collapse navbar-collapse rightMenu" id="navbarSupportedContent">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href='/about_the_challenge'
              >About the Challenge</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/">Final in South Africa</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href='/faqs'> FAQs </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/"> Tournament Date </a>
          </li>

          <li class="nav-item">
            <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link"  %>
          </li>
        </ul>
        <div class="dropdown profileWrap">
          <a
            class="profilePic"
            type="button"
            id="dropdownMenuButton1"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <% if current_user.image.attached? %>
              <%= image_tag current_user.image, id: 'profile-image' %>
            <% else %>
              <%= image_tag 'profile-pic-1.jpeg', alt: '' %>
            <% end %>
          </a>
        </div>
      </div>
    </div>
  </nav>
<% else %>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <%= image_tag 'FBround.png', alt: '', height: '86', class: 'roundedLogo' %>
        <%= image_tag 'MatchPlay2025.png', alt: '', height: '28', class: 'matchText' %>
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <%= image_tag 'Hamburger.png', alt: '', height: '28', class: 'Hamburger' %>
      </button>
      <div class="collapse navbar-collapse rightMenu" id="navbarSupportedContent">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href='/about_the_challenge'
              >About the Challenge</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/">Final in South Africa</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href='/faqs'> FAQs </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/"> Tournament Date </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href='/users/sign_in'> Log in </a>
          </li>
        </ul>
        <a class="btn btn-primary register" href='/users/sign_up'>Register</a>
      </div>
    </div>
  </nav>
<% end %>

<style>
.bg-dark {
  background: linear-gradient(90deg, rgb(0, 0, 0) 60%, rgb(0, 0, 0) 37%, #64bd59 100%) !important;
}
.navbar-dark {
  font-size: larger;
}
</style>