<section class="banner">
  <%= image_tag 'bannerImg.png', alt: '', class: 'bg' %>
  <div class="inner">
    <div class="sub">Manage your team here</div>
    <h1 class="title" id="context-content">Team</h1>
  </div>
</section>
<div class="matchesWrap">
  <div class="container maxWidth888">
    <%= render partial: 'layouts/tabs', locals: { page: 'team', match_started: false } %>
    <% if !current_user.team&.completed? %>
      <div class="row justify-content-center">
        <div class="col-12">
          <div class="card statusMsg">
            <div class="msgWrap">
              <i class="bx bx-info-circle"></i>
              <div class="info">
                <div class="title">Your Payment has not been updated! Please contact admin</div>
              </div>
            </div>
            <%
=begin%>
 <%= form_with url: create_checkout_session_path, method: :post, class: "pay-now-form", data: { turbo: false } do |form| %>
              <%= form.submit "Pay now", class: "btn btnSmall greenBtn" %>
            <% end %> 
<%
=end%>
          </div>
        </div>
      </div>
    <% end %>
    <%= render partial: 'teams/teams' %>
  </div>
</div>